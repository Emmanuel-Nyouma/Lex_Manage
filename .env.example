# ==============================================================================
# LexManage Environment Configuration Example
# Copy this file to .env and fill in the values.
# DO NOT commit the .env file to version control!
# ==============================================================================

# --- Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lexmanage_local_only
POSTGRES_DB=lexmanage

# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
# When using docker-compose, HOST should be 'postgres' (the service name)
DATABASE_URL=postgresql://postgres:lexmanage_local_only@postgres:5432/lexmanage

# --- Backend Configuration ---
PORT=3001
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Comma-separated — must NOT contain localhost in production
ALLOWED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
# Optional canonical public backend URL used for safe HTTP -> HTTPS redirects.
PUBLIC_API_URL=

# --- Redis (required for BullMQ background jobs) ---
REDIS_HOST=redis
REDIS_PORT=6379
# Managed Redis (Upstash / Render Key Value) — leave empty for the local container
REDIS_PASSWORD=
REDIS_TLS=false

# --- Object storage (S3-compatible: Supabase / MinIO / Storj / iDrive e2) ---
# Local MinIO container:  http://minio:9000
# Supabase Storage:       https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# Change from the defaults before deploying
S3_ACCESS_KEY=change_me_storage_user
S3_SECRET_KEY=change_me_storage_password
# Bucket must be pre-created on managed providers (e.g. Supabase dashboard)
S3_BUCKET=lexmanage-documents
# Encrypt every object at rest. Use aws:kms + S3_KMS_KEY_ID on AWS when available.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
# Local MinIO master key format: key-name:32-or-more-random-characters
MINIO_KMS_SECRET_KEY=lexmanage-local-key:CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# --- Gemini AI ---
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# --- n8n RAG Webhooks (optional — AI assistant is disabled if unset) ---
N8N_RAG_CHAT_URL=
N8N_RAG_INGEST_URL=
N8N_RAG_DELETE_URL=
# Required only when at least one n8n URL above is configured.
N8N_WEBHOOK_SECRET=
# n8n must verify X-LexManage-Timestamp and the v1 HMAC-SHA256 signature in
# X-LexManage-Signature over "<timestamp>.<raw JSON body>".

# --- Document malware scanning (required by default in production) ---
MALWARE_SCAN_MODE=required
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# --- Audit retention (90-3650 days) ---
AUDIT_RETENTION_DAYS=730

# --- Application-level encryption (exactly 32 random bytes, base64) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Email / Resend (optional — email notifications disabled if unset) ---
# Get your API key from https://resend.com/
RESEND_API_KEY=
# Must be a Resend-verified domain in production
MAIL_FROM=onboarding@resend.dev

# --- Frontend Configuration ---
VITE_APP_TITLE=LexManage
VITE_ENABLE_AI=true
VITE_SECURE_AUTH=true

# Dockerized deploy (docker compose): the frontend's own public origin. nginx
# serves the SPA here and proxies /api + /socket.io to the backend (same-origin).
FRONTEND_PUBLIC_URL=http://localhost
# Optional host port for the frontend container (default 80)
# FRONTEND_PORT=80

# Non-docker / separate-backend-domain builds use these directly instead.
# (Vite inlines them at build time.) Point at the backend's public URL.
VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=https://api.your-domain.com

# Optional privacy-preserving frontend error reporting. Leave empty to disable.
# Create a browser project in Sentry and paste only its public DSN here.
VITE_SENTRY_DSN=

# --- Local screenshot/report automation (optional) ---
# Base URL used by capture_screenshots.py.
LEXMANAGE_BASE_URL=http://localhost:5173
# Directory where automated screenshots are written.
LEXMANAGE_SCREENSHOT_DIR=report_screenshots
# Dedicated non-production account used only by local screenshot automation.
LEXMANAGE_TEST_EMAIL=example@example.com
LEXMANAGE_TEST_PASSWORD=CHANGE_ME

# --- Optional local demo seed (`cd lexmanage-backend && npx prisma db seed`) ---
SEED_ADMIN_EMAIL=admin@example.test
SEED_LAWYER_EMAIL=lawyer@example.test
SEED_USER_PASSWORD=CHANGE_ME_LOCAL_SEED_PASSWORD
